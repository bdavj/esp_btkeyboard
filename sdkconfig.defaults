# espkb defaults (ESP32-S3: the only ESP32 with both BLE and native USB device)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Save crash info to flash; it's summarised in the log on the next boot
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Logs go to UART0 (TX=GPIO43); the USB port is taken over by TinyUSB
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Bluetooth LE (NimBLE) as central with persistent bonds
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
CONFIG_BT_NIMBLE_MAX_BONDS=8
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# USB HID: boot keyboard + consumer control (media keys)
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_MSC_ENABLED=n

# Web UI
CONFIG_HTTPD_WS_SUPPORT=y

# Logging from Wi-Fi/system tasks via TinyUSB deepens their stacks: give them room
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_TINYUSB_TASK_STACK_SIZE=5120

# Hardware watchpoint on each task's stack end: a stack overflow panics at the
# offending write instead of silently corrupting the heap below it
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
